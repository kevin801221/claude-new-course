# ============================================================
# 資料來源的 API key —— 填好後 AI 才找得到真實資料集
# 用法：cp .env.example .env 然後把值填進 .env（.env 已被 gitignore）
# 一把都沒填也能跑：走 source="demo" 的合成資料，整條線一樣完整
# ============================================================

# Roboflow — 主要來源（Universe 上有 50 萬+ 個已標註資料集）
# 拿法：https://app.roboflow.com → 右上頭像 → Settings → 你的 Workspace → Roboflow API
#      要的是 Private API Key（不是 Publishable Key）
ROBOFLOW_API_KEY=

# Kaggle — 次要來源
# 拿法：https://www.kaggle.com/settings → API → Create New Token
#      會下載 kaggle.json，裡面有 username 與 key 兩個欄位
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face — 第三來源（datasets hub），公開資料集不填也能抓
# 拿法：https://huggingface.co/settings/tokens → New token（read 權限就夠）
HF_TOKEN=

# ============================================================
# 下面這些不用填，預設值就是對的
# ============================================================
# 訓練裝置：Apple Silicon 用 mps
AUTOCV_DEVICE=mps
